# Copy to .env and fill in. Never commit .env.

FLASK_APP=wsgi.py
FLASK_ENV=development

# Long random strings: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# PostgreSQL (target):
# DATABASE_URL=postgresql+psycopg://formsaathi:formsaathi@localhost:5432/formsaathi
# Quick local fallback without Postgres installed (file is created in backend/instance/):
DATABASE_URL=sqlite:///formsaathi_dev.db

# Admin account created on startup by `flask ensure-admin` (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploaded documents (private; outside any public folder)
UPLOAD_DIR=./instance/uploads
MAX_UPLOAD_MB=5

# Used in password-reset email links
FRONTEND_URL=http://localhost:5173

# Cookies: set true when served over HTTPS (production default is true)
COOKIE_SECURE=false

# --- Saathi AI. Leave empty and AI features honestly report "not configured".
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Defaults to claude-opus-5-5 when empty
LLM_MODEL=

# --- Email. Leave empty and emails are logged instead of sent (UI says so).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=FormSaathi <no-reply@formsaathi.local>

# Rate-limit storage (use redis://... when running several workers/instances)
RATELIMIT_STORAGE_URI=memory://
